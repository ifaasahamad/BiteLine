# Copy to .env.integration.local; never put credentials in tracked files.
# Only this exact database path is accepted. Never paste a development URI.
BITELINE_TEST_MONGO_URI=mongodb://127.0.0.1:27017/biteline_integration_test
# Generate a new secret locally; leave JWT_SECRET and MONGO_URI untouched.
BITELINE_TEST_JWT_SECRET=
# Required explicit acknowledgment of writes to the dedicated test namespace.
BITELINE_TEST_ALLOW_WRITE=yes
# Only needed for start:integration. Use a new synthetic-only password (12+ chars).
BITELINE_TEST_FIXTURE_PASSWORD=
